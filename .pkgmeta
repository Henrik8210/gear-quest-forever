# CurseForge / BigWigs packager (repo root — not inside GearQuest/).
# GearQuest Forever — new CurseForge project; TOC must not reuse the TBC project ID.
# Docs: https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File

package-as: GearQuestForever
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# package-as names the zip folder GearQuestForever. Source stays GearQuest/.
# Do not add move-folders GearQuest → GearQuestForever: packager deletes the
# dest copy when the source path is missing inside .release, leaving an empty zip.
# Releases zip this folder in GitHub Actions (see .github/workflows/release.yml)
# because packager still maps 1.x / 16xxx to Classic Era / Retail, not Forever.

ignore:
  - .gitignore
  - .github
  - .cursor
  - README.md
  - CHANGELOG.md
  - RELEASE.md
  - docs
  - scripts
  - assets
  - GearQuest/_generated/CURSOR-INTEGRATION-BRIEF.md
  - GearQuest/_generated/GEARQUEST-BIS-PIPELINE.md
  - GearQuest/_generated/*.json
  - pipeline
