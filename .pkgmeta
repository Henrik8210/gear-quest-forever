# CurseForge / BigWigs packager (repo root — not inside GearQuest/).
# GearQuest Forever — new CurseForge project; TOC must not reuse the TBC project ID.
# Docs: https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File

package-as: GearQuestForever
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# Repo source is GearQuest/; CurseForge zip root is GearQuestForever/ (distinct from TBC GearQuest).
move-folders:
  GearQuest: GearQuestForever

ignore:
  - .gitignore
  - .github
  - .cursor
  - README.md
  - CHANGELOG.md
  - RELEASE.md
  - docs
  - scripts
  - assets
  - GearQuest/_generated/CURSOR-INTEGRATION-BRIEF.md
  - GearQuest/_generated/GEARQUEST-BIS-PIPELINE.md
  - GearQuest/_generated/*.json
